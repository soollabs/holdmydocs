{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":combinePatchMinorReleases",
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "reviewers": ["soolbyte"],
  "labels": [
    "dependencies"
  ],
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{changelogs}}}{{{controls}}}",
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 day",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go", "toolchain"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "minimumReleaseAge": "0 days"
    }
  ]
}
