{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":combinePatchMinorReleases",
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "reviewers": ["soolbyte"],
  "labels": [
    "dependencies"
  ],
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{changelogs}}}{{{controls}}}",
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 day"
}
