            "gruvbox",
            "monokai",
            "nord",
            "one dark",
            "rosé pine",
            "solarized",
            "tokyo night"
          ]
        },
        "index": {
          "type": "string",
          "description": "one-segment page name used as the namespace index"
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pages",
              "namespaces",
              "pinned",
              "tags",
              "log",
              "health",
              "calendar",
              "writing-stats",
              "page-meta",
              "backlinks",
              "prev-entries"
            ]
          },
          "description": "complete ordered widget list; empty for the default set"
        },
        "tree": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "complete ordered list of page or folder paths for the page tree"
        },
        "new": {
          "type": "object",
          "properties": {
            "template": {
              "type": "string",
              "description": "one-segment page name whose body is used as the creation template"
            },
            "slug": {
              "type": "string",
              "description": "Go template that renders the new page's one-segment name; this is a naming pattern, not a page identifier"
            }
          },
          "description": "new-page template; set both fields empty to remove it",
          "required": [
            "template",
            "slug"
