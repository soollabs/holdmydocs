  {
    "name": "read_page",
    "title": "Read page",
    "description": "Read one page: its Markdown body, title, tags, pin state and hash. Pass the hash as basehash to edit_page, save_page or delete_page. A long body comes in windows: when truncated is true, call again with offset set to next_offset, or name a section to read only that part. After a partial read, change the body with edit_page, not save_page.",
    "x-scope": "read",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page identifier in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        },
        "section": {
          "type": "string",
          "description": "heading text; return only that heading and the text under it, up to the next heading of the same or a higher level"
        },
        "offset": {
          "type": "integer",
          "description": "first character of the body to return",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "maximum body characters to return",
          "minimum": 1,
          "maximum": 100000,
          "x-default": 40000
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "description": "the requested window of the body, or of the section when one is named"
        },
        "pin": {
          "type": "boolean"
        },
        "hash": {
          "type": "string",
          "description": "current revision of the whole page; pass as basehash to edit_page, save_page or delete_page"
        },
        "offset": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer",
          "description": "offset to pass for the following window"
        },
        "total_chars": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean",
          "description": "more text follows next_offset"
        }
      },
      "required": [
        "slug",
        "title",
        "tags",
        "body",
        "pin",
        "hash",
        "offset",
        "next_offset",
        "total_chars",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
