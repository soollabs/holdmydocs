              "title",
              "snippet",
              "tags"
            ],
            "additionalProperties": false
          }
        },
        "more": {
          "type": "boolean",
          "description": "further matches follow next_offset"
        },
        "next_offset": {
          "type": "integer",
          "description": "offset of the following page of hits"
        }
      },
      "required": [
        "hits",
        "more",
        "next_offset"
      ],
      "additionalProperties": false
    }
  },
