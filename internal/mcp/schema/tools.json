  {
    "name": "save_namespace",
    "title": "Save namespace",
    "description": "Create a namespace's settings, or update them with the basehash from read_namespace. Each save is one Git commit and never changes pages. On update, fields you omit keep their current values; lists and objects replace the stored value whole. A conflict error returns the current hash: re-read and retry.",
    "x-scope": "settings",
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "namespace name, e.g. notes; not a page slug, and it may not start with _ or ."
        },
        "basehash": {
          "type": "string",
          "description": "hash from read_namespace; required to update, omit to create"
        },
        "public": {
          "type": "boolean",
          "description": "whether anonymous visitors can read the namespace"
        },
        "title": {
          "type": "string",
          "description": "human-readable namespace title",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "description": "brief namespace description",
          "maxLength": 255
        },
        "image": {
          "type": "string",
          "description": "link preview image for pages without their own, as page/filename of a PNG or JPEG attachment in this namespace, e.g. index/hero.png"
        },
        "skin": {
          "type": "string",
          "description": "skin shown to visitors; empty for the default",
          "enum": [
            "",
            "phosphor",
            "newsprint",
            "journal",
            "soft",
            "bare"
          ]
        },
        "palette": {
          "type": "string",
          "description": "colour palette shown to visitors; empty for the skin's own",
