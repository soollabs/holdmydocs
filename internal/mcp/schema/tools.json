  {
    "name": "save_page",
    "title": "Save page",
    "description": "Create a page, or update one with the basehash from read_page. Each save is one Git commit. On update, fields you omit keep their current values; body and tags replace the stored value whole. Prefer edit_page to change part of a body. A conflict error returns the current hash and body: merge and retry with that hash.",
    "x-scope": "write",
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page identifier in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        },
        "basehash": {
          "type": "string",
          "description": "hash from read_page; required to update, omit to create"
        },
        "body": {
          "type": "string",
          "description": "complete Markdown body without frontmatter, at most 1 MiB as UTF-8; required to create, omit to keep the current body",
          "maxLength": 1048576
        },
        "title": {
          "type": "string",
          "description": "page title; defaults to the slug on create, omit to keep the current title",
          "maxLength": 256
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "description": "complete tag list; replaces the current tags, omit to keep them",
          "maxItems": 32
        },
        "pin": {
          "type": "boolean",
          "description": "show the page in the pinned sidebar widget; omit to keep the current value"
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "new revision; pass as basehash to the next change"
        },
        "index_warning": {
          "type": "string",
          "description": "set when the commit succeeded but search indexing is catching up in the background"
        }
      },
      "required": [
        "slug",
        "hash"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search",
    "title": "Search pages",
    "description": "Full-text search over accessible page titles, bodies and tags, best match first. Snippets are escaped HTML with <mark> around matches; use read_page for the whole page. When more is true, pass next_offset as offset for the next hits, or narrow the query or namespace.",
    "x-scope": "read",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "full-text query for page titles, bodies and tags",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "description": "only search pages in this namespace"
        },
        "offset": {
          "type": "integer",
          "description": "number of best matches to skip; pass next_offset from the previous call",
          "minimum": 0,
          "maximum": 1000
        },
        "limit": {
          "type": "integer",
          "description": "maximum hits to return",
          "minimum": 1,
          "maximum": 50,
          "x-default": 20
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
