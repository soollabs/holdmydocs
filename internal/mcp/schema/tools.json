    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page identifier in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "backlinks": {
          "type": "array",
