  {
    "name": "list_pages",
    "title": "List pages",
    "description": "List accessible pages with their slug, title and tags, sorted by slug. When more is true, pass next_offset as offset for the next pages. Use search to find pages by content.",
    "x-scope": "read",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "only list pages in this namespace"
        },
        "offset": {
          "type": "integer",
          "description": "number of pages to skip; pass next_offset from the previous call",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "maximum pages to return",
          "minimum": 1,
          "maximum": 500,
          "x-default": 100
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "slug",
              "title",
              "tags"
            ],
            "additionalProperties": false
          }
        },
        "more": {
          "type": "boolean",
          "description": "further pages follow next_offset"
        },
        "next_offset": {
          "type": "integer",
          "description": "offset of the following page of results"
        }
      },
      "required": [
        "pages",
        "more",
        "next_offset"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_attachment",
    "title": "Read attachment",
    "description": "Read the text extracted from an attachment, in windows of characters. When truncated is true, call again with offset set to next_offset. Use search_attachments to find the relevant part of a large document first.",
    "x-scope": "read",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page that owns the attachment, in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        },
        "filename": {
          "type": "string",
          "description": "attachment filename without a directory"
        },
        "offset": {
          "type": "integer",
          "description": "first character to return",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "maximum characters to return",
          "minimum": 1,
          "maximum": 100000,
          "x-default": 40000
        }
      },
      "required": [
        "slug",
        "filename"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer",
          "description": "offset to pass for the following window"
        },
        "total_chars": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean",
          "description": "more text follows next_offset"
        }
      },
      "required": [
        "text",
        "offset",
        "next_offset",
        "total_chars",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
