      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_page",
    "title": "Delete page",
    "description": "Delete a page in one Git commit; it stays recoverable from history. Pass basehash to delete only the revision you read.",
    "x-scope": "write",
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page identifier in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        },
        "basehash": {
          "type": "string",
          "description": "hash from read_page; when set, the page is deleted only if it is still that revision"
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "edit_page",
    "title": "Edit page",
    "description": "Replace exact text in an existing page's Markdown body without resending it; title, tags and pin are kept. Each oldText must match exactly once when its edit is applied, and any failed edit cancels the whole call. All edits land in one commit; dryRun returns the diff without committing. A conflict error returns the current hash: re-read and retry.",
    "x-scope": "write",
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "page identifier in namespace/page form, e.g. notes/my-page; no segment may start with _ or ."
        },
        "basehash": {
          "type": "string",
          "description": "hash from read_page or the last save or edit"
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oldText": {
                "type": "string",
                "description": "exact existing Markdown text; must occur exactly once",
                "minLength": 1
              },
              "newText": {
                "type": "string",
                "description": "replacement Markdown text; empty deletes oldText"
              }
            },
            "required": [
              "oldText",
              "newText"
            ],
            "additionalProperties": false
          },
          "description": "replacements, applied in order",
          "minItems": 1,
          "maxItems": 128
        },
        "dryRun": {
          "type": "boolean",
          "description": "return the diff without committing"
        }
      },
      "required": [
        "slug",
        "basehash",
        "edits"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "new revision; pass as basehash to the next change"
        },
        "changed": {
          "type": "boolean"
        },
        "diff": {
          "type": "string",
          "description": "unified diff of the body; empty when unchanged"
        },
        "index_warning": {
          "type": "string",
          "description": "set when the commit succeeded but search indexing is catching up in the background"
        }
      },
      "required": [
        "slug",
        "hash",
        "changed",
        "diff"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "health",
    "title": "Wiki health",
    "description": "Report dangling [[wiki-links]] whose target page is missing, orphan pages with no incoming links, and stale pages with no commit in 180 days.",
    "x-scope": "read",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "limit the report to this namespace; omit for the whole wiki"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "slug",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "orphans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "last_updated": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "last_updated"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "missing",
        "orphans",
        "stale"
      ],
      "additionalProperties": false
    }
  },
