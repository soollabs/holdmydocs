# hmd install-wide configuration file.
#
# hmd creates <HMD_APP_DIR>/config.yaml when you first save /settings.
# This example is reference-only. Copy or adapt it only after replacing or
# commenting out unsuitable placeholders, including the remote and token settings.
# Set HMD_CONFIG_FILE to use another path.
#
# Every key here also has a HMD_<KEY, upper-cased> env var equivalent, with
# nested keys folding their section into the name (e.g. repo_dir <->
# HMD_REPO_DIR, git.remote_url <-> HMD_GIT_REMOTE_URL, oidc.client_id <->
# HMD_OIDC_CLIENT_ID). Environment values override this file, useful for
# Docker/k8s deployments. Unknown keys are rejected at startup.
#
# All keys are optional; omit anything you want left at its default. Wiki
# identity and landing settings are stored separately in <repo_dir>/.wiki.yaml.
#
# Skin, palette and fonts are per-user preferences, set from /settings —
# not in this file.

# --- Server ---
bind: ":8080"
repo_dir: /data/repo

# --- Git remote ---
git:
  # HTTPS only (git@ SSH remotes are not yet supported).
  remote_url: https://git.example.com/you/wiki.git
  user: you

  # Prefer token_file over token — it keeps the PAT out of this file and
  # out of `docker inspect`/process listings. Pick one, not both.
  token_file: /run/secrets/git_token
  # token: pat_xyz

  # Global commit author in "Name <email>" form. Commits use the per-user
  # author, then this global author, then the logged-in username if neither is
  # set.
  # author: hmd <hmd@example.com>

# --- Bootstrap admin user ---
# Set via HMD_ADMIN_USER / HMD_ADMIN_PASSWORD env vars only (first run).
# Manage users afterwards with `hmd adduser <name>`.

# --- Behaviour ---
max_upload_bytes: 10485760   # 10 MiB
sync_poll_ms: 10000
# sync_mode: push (default, local → remote only) or bidirectional
# (fetch + fast-forward pull on every sync poll and before each save,
# so changes pushed by other writers appear in the UI automatically)
# sync_mode: bidirectional
# default_branch: main   # branch name used when initialising a fresh local repo
# Install-wide default skin: phosphor | newsprint | journal | soft | bare.
# A skin controls presentation, not widget composition or storage. Users can
# override it from /settings.
# skin: phosphor

# --- Document extraction and semantic search ---
# HMD_TIKA_URL is environment-only. When set, startup verifies the Apache Tika
# Server and enables attachment extraction/search; when absent, attachments are
# still stored but are not extracted or indexed.
# HMD_TIKA_URL: http://tika:9998
# document_search:
#   # Defaults to BAAI/bge-small-en-v1.5. Override with
#   # HMD_DOCUMENT_SEARCH_MODEL; models need Hugot-compatible ONNX files and
#   # 384-dimensional output.
#   model: BAAI/bge-small-en-v1.5
#   # Defaults to <HMD_APP_DIR>/models. HMD downloads the
#   # pinned, checksum-verified BGE Small ONNX model there on first use.
#   index_dir: ""                 # defaults to <HMD_APP_DIR>/search.bleve

# --- OIDC single sign-on ---
# Optional. Setting oidc.issuer enables SSO and requires a restart. Register
# hmd as a confidential client with your provider and use
# <oidc.base_url>/auth/oidc/callback as the redirect URI.
# oidc:
#   issuer: https://auth.example.com
#   client_id: hmd
#   # Prefer HMD_OIDC_CLIENT_SECRET (env) over putting the secret in this file.
#   client_secret: change-me
#   base_url: https://wiki.example.com   # public URL of this hmd instance
#   local_login: true                    # false hides the password form
#   button_text: Sign in with SSO        # e.g. "Login with Authelia"
#   # SSO button icon: a name from https://dashboardicons.com/ (fetched once at
#   # startup and served locally) or a path to an SVG file. SVGs must be square
#   # (equal viewBox or width/height) and at most 256 KiB.
#   icon: authelia
#   # icon: /etc/hmd/sso-icon.svg

# --- Publishing ---
# Publishing is a namespace property, not a config-file setting: set
# `public: true` in a namespace's .namespace.yaml (e.g. blog/.namespace.yaml)
# to serve every page in that namespace read-only and unauthenticated at its
# normal URL. See .namespace.yaml docs. Note: markdown bodies may contain raw
# HTML, so publishing a page publishes its raw HTML too.

# --- MCP server ---
# Expose the wiki to AI agents over MCP (streamable HTTP at /mcp).
# Requires a personal access token from /settings. Restart required.
# mcp:
#   enabled: true
