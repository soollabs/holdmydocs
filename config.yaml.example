# hmd install-wide configuration file.
#
# hmd looks for this at <HMD_APP_DIR>/config.yaml by default (created
# automatically the first time you save /settings) — no need to copy this
# file anywhere or set HMD_CONFIG_FILE unless you want it somewhere else.
#
# Every key here also has a HMD_<KEY, upper-cased> env var equivalent, with
# nested keys folding their section into the name (e.g. repo_dir <->
# HMD_REPO_DIR, git.remote_url <-> HMD_GIT_REMOTE_URL, oidc.client_id <->
# HMD_OIDC_CLIENT_ID). Env always wins over this file, handy for Docker/k8s
# deploys. Unknown keys are rejected at startup — a typo fails loudly
# instead of being silently ignored.
#
# All keys are optional; omit anything you want left at its default.
#
# Theme colours, fonts, and the tags-sidebar toggle are per-user
# preferences, set from /settings — not in this file.

# --- Server ---
bind: ":8080"
repo_dir: /data/repo

# --- Git remote ---
git:
  # HTTPS only (git@ SSH remotes are not yet supported).
  remote_url: https://git.example.com/you/wiki.git
  user: you

  # Prefer token_file over token — it keeps the PAT out of this file and
  # out of `docker inspect`/process listings. Pick one, not both.
  token_file: /run/secrets/git_token
  # token: pat_xyz

  # Default commit author, in "Name <email>" form. Used for every commit
  # unless a user has set their own author on the settings page. Falls
  # back to the logged-in username when unset.
  # author: hmd <hmd@example.com>

# --- Bootstrap admin user ---
# Set via HMD_ADMIN_USER / HMD_ADMIN_PASSWORD env vars only (first run).
# Manage users afterwards with `hmd adduser <name>`.

# --- Site / shell-prompt appearance ---
site_name: Homelab Wiki
hostname: homelab
path_label: ~/wiki
# user_label: alice   # overrides the logged-in username in the sidebar prompt

# --- Behaviour ---
max_upload_bytes: 10485760   # 10 MiB
sync_poll_ms: 10000
# sync_mode: push (default, local → remote only) or bidirectional
# (fetch + fast-forward pull on every sync poll and before each save,
# so changes pushed by other writers appear in the UI automatically)
# sync_mode: bidirectional
# default_branch: main   # branch name used when initialising a fresh local repo
# Home page file. Must end in .md, no path separators, not dot-prefixed.
# Default readme.md renders on the git host front page (GitHub, git, Gitea).
# home_filename: readme.md

# --- OIDC single sign-on ---
# Optional. Setting oidc.issuer enables SSO (restart required). Register hmd
# with your provider (Authentik, Authelia, Pocket ID, ...) as a confidential
# client with redirect URI <oidc.base_url>/auth/oidc/callback.
# oidc:
#   issuer: https://auth.example.com
#   client_id: hmd
#   # Prefer HMD_OIDC_CLIENT_SECRET (env) over putting the secret in this file.
#   client_secret: change-me
#   base_url: https://wiki.example.com   # public URL of this hmd instance
#   local_login: true                    # false hides the password form
#   button_text: Sign in with SSO        # e.g. "Login with Authelia"
#   # Icon on the SSO button: a name from https://dashboardicons.com/ (fetched
#   # once at startup, then served locally) or a path to an SVG file. The SVG
#   # must be square (equal viewBox or width/height) and at most 256 KiB.
#   icon: authelia
#   # icon: /etc/hmd/sso-icon.svg

# --- Digital garden ---
# Serve pages with `public: true` frontmatter read-only and unauthenticated
# under /garden/ (index, pages, RSS at /garden/feed.xml). Restart required.
# Note: markdown bodies may contain raw HTML, so publishing a page publishes
# its raw HTML too.
# garden:
#   enabled: true
#   title: My Garden   # defaults to site_name

# --- MCP server ---
# Expose the wiki to AI agents over MCP (streamable HTTP at /mcp).
# Requires a personal access token, created under /settings.
# Restart required.
# mcp:
#   enabled: true
